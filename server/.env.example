# Server Configuration
NODE_ENV=development
PORT=3005

# Discord OAuth (Application - NOT Bot)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3005/api/auth/discord/callback
DISCORD_GUILD_ID=your_guild_id

# Admin Users (comma-separated Discord User IDs)
DISCORD_ADMIN_IDS=

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be at least 32 chars and NOT contain placeholder words like "change-this".
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Session Configuration
# Same generation rule as JWT_SECRET.
SESSION_SECRET=

# Tebex Headless API token — server-side only, used by /api/tebex/* proxy.
# This is the public webstore token shown in the Tebex dashboard. Do NOT expose
# it in the client bundle.
TEBEX_PUBLIC_TOKEN=

# Secondary Tebex token for the OXLYN PACK claim flow (My Downloads modal).
# Optional — leave blank if you don't run a separate claim store. When unset,
# the /api/tebex-claim/* endpoints respond 503.
TEBEX_CLAIM_TOKEN=

# MariaDB/MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=oxlyn_tebex

# Downloads Configuration
DOWNLOADS_PATH=

# CORS - origin allowed to call the API
CLIENT_URL=http://localhost:5173

# Development: Test IP for geolocation (optional)
TEST_IP=
