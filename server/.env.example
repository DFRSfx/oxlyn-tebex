# Server Configuration
NODE_ENV=development
PORT=3001

# Discord OAuth (Application - NOT Bot)
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
DISCORD_GUILD_ID=your_discord_server_id

# Admin Users (comma-separated Discord User IDs)
# Get your Discord ID: User Settings > Advanced > Developer Mode > Right-click yourself > Copy ID
DISCORD_ADMIN_IDS=123456789012345678,987654321098765432

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_to_random_string

# MariaDB/MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=oxlyn_tebex

# Downloads Configuration
# Create this folder manually: mkdir C:\oxlyn-downloads (Windows) or mkdir /var/oxlyn-downloads (Linux)
DOWNLOADS_PATH=C:\oxlyn-downloads

# CORS
CLIENT_URL=http://localhost:5173
